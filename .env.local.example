# MY MANDAT — AI advisor (Penasihat AI)
# Copy to .env.local and fill in your key to enable the live Claude-powered
# advisor at /advisor. Without a key the advisor runs in local simulation
# (rule-based) mode — the game remains fully playable.
ANTHROPIC_API_KEY=sk-ant-...

# MY MANDAT — account login (/login, /register)
# Copy to .env.local and fill in your Supabase project's values to enable
# accounts. Find these under Project Settings > API in your Supabase
# dashboard. Without them, login/register is skipped entirely and the game
# is reachable directly, same local-fallback pattern as the advisor above.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
